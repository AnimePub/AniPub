<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | AniPub – Stream Anime Free in HD</title>
    <meta name="description" content="Home Page - A Free Anime Watching Site built by Anime Lovers for Anime Lovers">
    <meta name="keywords" content="anime, anime streaming, watch anime online, hianime, anilab, gogoanime, 9anime, zoro, aniplex, AniPub">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito:wght@400;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/newHome.css">
<style>
  .airing-section{max-width:1400px;margin:0 auto;}

  .sec-head{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:20px;
  }
  .sec-bar{
    width:5px;
    height:22px;
    background:var(--accent, #2ea8ff);
    border-radius:2px;
  }
  .sec-head p{
    margin:0;
    font-weight:700;
    text-transform:uppercase;
  }

 
  .slider-wrap{
    position:relative;
  }

  .airing-track{
    display:flex;
    gap:18px;
    overflow-x:auto;
    scroll-behavior:smooth;
    scroll-snap-type:x proximity;
    padding:4px 4px 12px;
    scrollbar-width:none;
    -ms-overflow-style:none;
    cursor:grab;
  }
  .airing-track::-webkit-scrollbar{display:none;}
  .airing-track.dragging{cursor:grabbing;scroll-behavior:auto;}

  .airing-card{
    flex:0 0 auto;
    width:200px;
    scroll-snap-align:start;
    text-decoration:none;
    color:inherit;
    display:block;
    user-select:none;
  }

  .airing-card-img{
    width:100%;
    aspect-ratio:2/3;
    border-radius:10px;
    overflow:hidden;
    background:#12161f;
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .airing-card:hover .airing-card-img{
    transform:translateY(-4px);
    box-shadow:0 10px 24px rgba(0,0,0,.5);
  }
  .airing-card-img img{
    width:100%;height:100%;object-fit:cover;
    display:block;
    pointer-events:none;
  }

  .airing-card-body{padding-top:10px;}
  .airing-card-title{
    font-size:14px;
    font-weight:600;
    line-height:1.3;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .airing-card-rating{
    display:flex;
    align-items:center;
    gap:6px;
    margin:4px 0;
    font-size:12px;
  }
  .airing-rating-num{color:#ffb020;font-weight:700;}
  .airing-rating-stars{height:12px;}
  .airing-card-desc{
    margin:0;
    font-size:12px;
    color:#8a93a3;
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }


  .slide-btn{
    position:absolute;
    top:38%;
    transform:translateY(-50%);
    width:38px;height:38px;
    border-radius:50%;
    border:none;
    background:rgba(15,18,26,.85);
    color:#e8ecf1;
    font-size:18px;
    display:flex;align-items:center;justify-content:center;
    cursor:pointer;
    z-index:5;
    box-shadow:0 4px 14px rgba(0,0,0,.5);
    transition:background .2s ease, opacity .2s ease;
    opacity:0;
  }
  .slider-wrap:hover .slide-btn{opacity:1;}
  .slide-btn:hover{background:#2ea8ff;}
  .slide-btn.prev{left:-6px;}
  .slide-btn.next{right:-6px;}
  .slide-btn[disabled]{
    opacity:0 !important;
    pointer-events:none;
  }

  .fade-edge{
    position:absolute;
    top:0;bottom:12px;
    width:60px;
    pointer-events:none;
    z-index:4;
  }
  .fade-edge.left{left:0;background:linear-gradient(90deg,#0b0e14,transparent);}
  .fade-edge.right{right:0;background:linear-gradient(270deg,#0b0e14,transparent);}

  @media (max-width:600px){
    .airing-card{width:130px;}
    .slide-btn{display:none;}
  }
</style>
</head>

<body>
