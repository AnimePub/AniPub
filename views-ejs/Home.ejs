                <h1 class="slide-title"><%=value.Name%></h1>

                <div class="slide-meta">
                    <span class="meta-tag"><%= value.Duration %></span>
                    <span class="meta-tag"><%= value.Aired %></span>
                    <% if (value.ep.length === 0) {%>
