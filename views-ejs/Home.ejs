<section class="airing-section">
    <!-- Section Header -->
    <div class="sec-head">
        <div class="sec-bar"></div>
        <a href="https://anipub.xyz/search/q?type=Action" style="text-decoration: none; color: inherit;">
            <p>Action</p>
        </a>
    </div>

    <!-- Slider -->
    <div class="slider-wrap">
        <button class="slide-btn prev" aria-label="Previous">&#10094;</button>
        <div class="fade-edge left"></div>

        <div class="airing-track" id="airingTrack">
            <% Airing.forEach(value => { %>
                <a href="https://anipub.xyz/AniPlayer/<%=value.finder%>/0" class="airing-card">
                    <!-- Card Image -->
                    <div class="airing-card-img">
                        <% const POSTER = value.ImagePath;
                           const POSTERARY = POSTER.split("https://");
                           let LINKU = "";
                           if(POSTERARY.length > 1){
                               LINKU = "https://" + POSTERARY[1];
                           } else {
                               LINKU= "/"+POSTERARY[0]
                           }
                        %>
                        <img src="<%=LINKU%>" alt="<%=value.Name%> Poster" draggable="false">
                    </div>

                    <!-- Card Body -->
                    <div class="airing-card-body">
                        <div class="airing-card-title"><%=value.Name%></div>
                        <div class="airing-card-rating">
                            <span class="airing-rating-num"><%=value.MALScore%></span>
                            <img class="airing-rating-stars" src="/rating-<%=value.RatingsNum%>.png" alt="Rating">
                        </div>
                        <p class="airing-card-desc">
                            <% const desc = value.DescripTion;
                               const descr = desc && desc.length > 60 ? desc.slice(0, 60) : desc;
                            %>
                            <%=descr%>...
                        </p>
                    </div>
                </a>
            <% }); %>
        </div>

        <div class="fade-edge right"></div>
        <button class="slide-btn next" aria-label="Next">&#10095;</button>
    </div>
</section>



<script>
(function(){
  const track = document.getElementById('airingTrack');
  const wrap = track.closest('.slider-wrap');
  const prevBtn = wrap.querySelector('.slide-btn.prev');
  const nextBtn = wrap.querySelector('.slide-btn.next');

  function scrollByCard(dir){
    const card = track.querySelector('.airing-card');
    const cardWidth = card ? card.getBoundingClientRect().width + 18 : 220;
    track.scrollBy({ left: dir * cardWidth * 3, behavior: 'smooth' });
  }
  prevBtn.addEventListener('click', () => { scrollByCard(-1); restartAutoScroll(); });
  nextBtn.addEventListener('click', () => { scrollByCard(1); restartAutoScroll(); });

  function updateButtons(){
    prevBtn.disabled = track.scrollLeft <= 4;
    nextBtn.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
  }
  track.addEventListener('scroll', updateButtons);
  window.addEventListener('resize', updateButtons);
  updateButtons();


  const AUTO_INTERVAL = 3500;   
  const RESUME_DELAY  = 4000;   
  let autoTimer = null;
  let resumeTimer = null;

  function advance(){
    const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    if(atEnd){
      track.scrollTo({ left: 0, behavior: 'smooth' }); // loop back to start
    } else {
      scrollByCard(1);
    }
  }

  function startAutoScroll(){
    stopAutoScroll();
    autoTimer = setInterval(advance, AUTO_INTERVAL);
  }
  function stopAutoScroll(){
    if(autoTimer){ clearInterval(autoTimer); autoTimer = null; }
  }
  function restartAutoScroll(){
    stopAutoScroll();
    clearTimeout(resumeTimer);
    resumeTimer = setTimeout(startAutoScroll, RESUME_DELAY);
  }

 
  wrap.addEventListener('mouseenter', stopAutoScroll);
  wrap.addEventListener('mouseleave', startAutoScroll);
  track.addEventListener('touchstart', () => { stopAutoScroll(); }, { passive: true });
  track.addEventListener('touchend', restartAutoScroll, { passive: true });
  track.addEventListener('wheel', restartAutoScroll, { passive: true });

 
  document.addEventListener('visibilitychange', () => {
    if(document.hidden) stopAutoScroll(); else startAutoScroll();
  });

  startAutoScroll();

 
  let isDown = false, startX, scrollLeftStart, dragged = false;

  track.addEventListener('mousedown', e => {
    isDown = true;
    dragged = false;
    track.classList.add('dragging');
    startX = e.pageX - track.offsetLeft;
    scrollLeftStart = track.scrollLeft;
    stopAutoScroll();
  });
  window.addEventListener('mouseup', () => {
    isDown = false;
    track.classList.remove('dragging');
    restartAutoScroll();
  });
  track.addEventListener('mouseleave', () => {
    isDown = false;
    track.classList.remove('dragging');
  });
  track.addEventListener('mousemove', e => {
    if(!isDown) return;
    e.preventDefault();
    dragged = true;
    const x = e.pageX - track.offsetLeft;
    const walk = (x - startX) * 1.2;
    track.scrollLeft = scrollLeftStart - walk;
  });
  track.addEventListener('click', e => {
    if(dragged){ e.preventDefault(); e.stopPropagation(); }
  }, true);
})();
</script>




